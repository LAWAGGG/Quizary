# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# URL API backend (wajib diisi)
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api

# Untuk development lokal pakai IP LAN laptop kamu
# Contoh: EXPO_PUBLIC_API_URL=http://192.168.0.100:8000/api

# Untuk production / EAS Cloud APK pakai URL https tunnel (wajib https, 10.0.2.2 hanya untuk emulator)
# Contoh: EXPO_PUBLIC_API_URL=https://ion-smile-bedrooms-addresses.trycloudflare.com/api
# Jika build EAS Cloud, set juga di eas.json preview.env.EXPO_PUBLIC_API_URL atau via: eas secret:create --name EXPO_PUBLIC_API_URL --value https://xxx.trycloudflare.com/api

# Disable react-navigation compatibility check (wajib untuk SDK 56+)
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

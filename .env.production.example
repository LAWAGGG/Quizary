# Copy: cp .env.production.example .env.prod
# Pakai: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Password + SECRET_KEY BUKAN di sini — via secrets/*.txt (gitignore).

MYSQL_DATABASE=fastapi_quizary
MYSQL_USER=quizary

# Frontend baked saat build. Single origin via nginx → biarkan /api.
VITE_API_URL=/api

# Domain publik eksak, koma-pisah. Wajib isi bila frontend di host beda.
# Contoh: CORS_EXTRA_ORIGINS=https://quizary.id,https://www.quizary.id
CORS_EXTRA_ORIGINS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
